# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Signing material — never commit
*.keystore
*.jks
.env
.env.*
key.properties

# Prebuilt TDLib binaries (81 MB). Restore with scripts/fetch_tdlib.sh;
# the archive checksum is recorded in README.md.
android/app/src/main/jniLibs/**/*.so

# Generated from lib/l10n/*.arb by `flutter gen-l10n`, which `flutter pub get`
# runs for us (pubspec: flutter.generate). The .arb files are the source.
lib/l10n/app_localizations*.dart
